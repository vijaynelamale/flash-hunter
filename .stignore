// Syncthing ignore patterns for flash-hunter
// Exclude host development venvs, compiled binaries, cache, and runtime databases

.venv
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

// Host build / cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

// Local runtime databases and logs
*.db
*.db-wal
*.db-shm
data/*.db
data/*.db-wal
data/*.db-shm
logs/
*.log

// Local secret overrides and session states
.env
*.session
*.session-journal

// OS / IDE artifacts
.DS_Store
.idea/
.vscode/
