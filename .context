{
  "project_metadata": {
    "name": "flash-hunter",
    "version": "1.2.0",
    "description": "Autonomous Flash-Sale Hunter & Auto-Checkout Assistant for Amazon India & Flipkart",
    "deployment_target": "Xiaomi Mi TV Motherboard (Headless Android + Native Termux)",
    "repository": "https://github.com/vijaynelamale/flash-hunter",
    "supported_platforms": ["amazon.in", "flipkart.com"],
    "last_updated": "2026-11-02T14:15:00Z",
    "agent_version": "bob-agent-v2"
  },
  "hardware_profile": {
    "device_name": "Xiaomi Mi TV Motherboard",
    "soc": "Amlogic Quad-Core ARM Cortex-A53",
    "kernel_architecture": "aarch64",
    "userland_architecture": "armeabi-v7a (32-bit userland for memory optimization)",
    "physical_ram_mb": 2048,
    "max_rss_threshold_mb": 190.0,
    "max_rss_threshold_kb": 194560,
    "storage_type": "eMMC Flash",
    "power_profile": "Android TV Leanback with Wake-Lock and Doze Whitelist",
    "supervisor_script": "scripts/start_hunter_termux.sh"
  },
  "execution_topologies": {
    "standalone": {
      "mode": "STANDALONE",
      "adb_target": "127.0.0.1:5555",
      "description": "Python pipeline running directly inside Native Termux on Mi TV board"
    },
    "remote_lan": {
      "mode": "REMOTE_LAN",
      "adb_target": "10.42.0.90:5555",
      "description": "Python pipeline running on Dev Host controlling Mi TV over LAN Wi-Fi ADB"
    },
    "mock_offline": {
      "mode": "MOCK",
      "dry_run": true,
      "description": "100% offline mocked unit testing on Dev Host without hardware"
    }
  },
  "budget_and_safety_controls": {
    "global_budget_limit_inr": 10000.0,
    "daily_spend_limit_inr": 10000.0,
    "max_single_item_price_inr": 10000.0,
    "post_order_kill_switch_count": 1,
    "checkout_cooldown_seconds": 60,
    "crazy_deal_override": {
      "enabled": true,
      "min_discount_percent": 90.0,
      "max_price_inr": 10000.0
    },
    "telegram_notifications": {
      "enabled": true,
      "threshold_price_inr": 10000.0
    }
  },
