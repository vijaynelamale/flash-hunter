  "known_limitations_and_workarounds": [
    {
      "limitation_id": "LIM-001",
      "title": "Android TV WebView App Link Domain Verification Failure",
      "description": "Direct deep link intents for amazon.in/dp/ fail on Android TV due to missing custom tabs / domain verification in Leanback OS.",
      "workaround": "2-Tier Navigation Strategy in ADBCheckoutDriver: attempts direct intent, and if Buy Now is not present in 3s, enters ASIN in in-app search bar (rs_search_src_text).",
      "reference_file": "src/checkout/adb_checkout.py",
      "reference_line": 124
    },
    {
      "limitation_id": "LIM-002",
      "title": "Android FLAG_SECURE on NPCI UPI Payment Screens",
      "description": "UPI PIN keypad screens block UIAutomator2 inspection and tap injection via OS-level security flags.",
      "workaround": "Strictly restricted to Zero-OTP payment methods: Amazon Pay Balance, Flipkart Gift Card / Wallet Balance, and COD.",
      "reference_file": "src/checkout/adb_checkout.py",
      "reference_line": 158
    },
    {
      "limitation_id": "LIM-003",
      "title": "Mid-Checkout Flash Sale Price Surges",
      "description": "Lightning deals or flash coupons expiring between ingestion and final order placement causing checkout price jumps.",
      "workaround": "Mandatory final UI XML hierarchy price extraction before clicking Place Order; triggers PRICE_JUMP_ABORT and returns to home screen if price exceeds authorized limit.",
      "reference_file": "src/checkout/adb_checkout.py",
      "reference_line": 180
    },
    {
      "limitation_id": "LIM-004",
      "title": "Termux 2GB RAM Compilation OOM",
      "description": "Building native Python C-extensions/Rust wheels exhausts physical memory on Mi TV.",
      "workaround": "Set CARGO_BUILD_JOBS=1, RUSTFLAGS='-C opt-level=1 -C debuginfo=0', and install prebuilt Termux C libraries.",
      "reference_file": "scripts/bootstrap_termux_target.sh",
      "reference_line": 24
    }
  ],
  "configuration_registry": {
    "settings_yaml": "config/settings.yaml",
    "targets_yaml": "config/targets.yaml",
    "env_example": ".env.example",
    "agents_md": "AGENTS.md",
    "project_context": "PROJECT_CONTEXT.md",
    "state_db": "data/flash_hunter.db"
  }
}
