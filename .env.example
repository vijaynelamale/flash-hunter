# ==============================================================================
# Flash-Hunter Environment Configuration (.env)
# ==============================================================================

# --- Execution Topology & Modes ---
# STANDALONE (Termux on Mi TV), REMOTE_LAN (Host controlling Mi TV via ADB), or MOCK (Dev test)
EXECUTION_MODE=STANDALONE
DRY_RUN=true
LOG_LEVEL=INFO

# --- Android ADB Automation ---
# Use 10.42.0.90:5555 for your MITV target
ADB_TARGET=10.42.0.90:5555
CHECKOUT_DRIVER=adb
PREFERRED_PAYMENT_METHOD=AMAZON_PAY_BALANCE  # Options: AMAZON_PAY_BALANCE, FLIPKART_GIFT_CARD, COD

# --- LAN Webhook Offload (Optional when CHECKOUT_DRIVER=webhook) ---
WEBHOOK_URL=http://192.168.1.100:8080/checkout
WEBHOOK_SECRET=your_hmac_shared_secret_here

# --- State Store & Database ---
DATABASE_PATH=data/flash_hunter.db

# --- Circuit Breaker & Financial Safety ---
DAILY_SPEND_LIMIT_INR=10000.0
MAX_SINGLE_ITEM_PRICE_INR=5000.0
POST_ORDER_KILL_SWITCH_COUNT=1
CHECKOUT_COOLDOWN_SECONDS=60

# --- Crazy Deal Global Override ---
CRAZY_DEAL_ENABLED=true
CRAZY_DEAL_MIN_DISCOUNT_PERCENT=90.0
CRAZY_DEAL_MAX_PRICE_INR=1000.0

# --- Telegram API & Notification Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_CHANNELS=@deals_india,@looter_deals,@flipkart_amazon_loots

# --- Cloud LLM Verification ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_CONFIDENCE_THRESHOLD=0.85
